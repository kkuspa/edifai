# Copy to .env and fill in what you need. .env is git-ignored; never commit keys.
# Nothing here is required: the default simulated planner runs offline.

# ---- Live LLM planner (optional) --------------------------------------------
# Provider for `--planner live`: anthropic or openai.
# Leave blank to use whichever key below is set (Anthropic first).
LLM_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a proxy or gateway in front of the Anthropic API.
# ANTHROPIC_BASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional: any OpenAI-compatible endpoint (vLLM, Ollama, a gateway).
# OPENAI_BASE_URL=

# ---- OpenTelemetry export to Jaeger (optional) -------------------------------
# Local spans.jsonl is always written. Set this to also export over OTLP HTTP.
# From the host:            http://localhost:4318/v1/traces
# From another container:   http://jaeger:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# JAEGER_UI_URL=http://localhost:16686
