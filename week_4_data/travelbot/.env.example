# Live-model configuration (optional). The workshop runs fully offline with the simulated
# planner; set these only for `--planner live`. Copy to .env, which git ignores. Keys stay
# in the backend process; the GUI never sees them.

# Which provider live runs use: anthropic or openai. If unset, whichever key is present wins
# (Anthropic if both are set). --provider on the command line overrides this.
LLM_PROVIDER=

# --- Anthropic (Claude) ---
# Leave blank if you ran `ant auth login`; the SDK reads that profile.
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5. claude-sonnet-5-5 is a cheaper choice for a classroom.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional reasoning effort: low, medium, high, xhigh, max. Blank uses the API default.
ANTHROPIC_EFFORT=
# Server-side fallback when a request is declined by a safety classifier ("default" or blank).
ANTHROPIC_SERVER_FALLBACKS=default

# --- OpenAI ---
OPENAI_API_KEY=
# Use a model your account can access; check the OpenAI models page before class.
OPENAI_MODEL=gpt-5.5
# Optional: minimal, low, medium, high. Blank uses the API default.
OPENAI_REASONING_EFFORT=
# Optional. Many current OpenAI reasoning models accept only the default temperature; leave blank.
OPENAI_TEMPERATURE=

# --- Shared ---
# Output token cap per model call (thinking plus the reply), and retries for malformed tool calls (bounded).
LLM_MAX_TOKENS=16000
LLM_MAX_RETRIES=2
